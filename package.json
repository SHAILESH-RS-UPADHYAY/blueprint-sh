{
  "name": "blueprint-sh",
  "version": "1.0.0",
  "private": true,
  "description": "Drop a codebase in, get its architecture drawn. Parsing, layout and rendering all run in the browser.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run sample && vite",
    "build": "npm run sample && npm run typecheck && vite build",
    "preview": "vite preview",
    "sample": "node scripts/sample.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "elkjs": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "license": "MIT"
}
